<mxfile host="drawio" version="26.2.15"><diagram id="arch" name="aws"><mxGraphModel dx="1700" dy="900" grid="1" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="1720" pageHeight="860" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="g_cap" value="Step 1: video to twin (workstation or CI)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontSize=13;arcSize=2;strokeColor=#E8A33D;" vertex="1" parent="1"><mxGeometry x="20" y="70" width="565" height="180" as="geometry"/></mxCell><mxCell id="g_floor" value="On the floor (food bank)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontSize=13;arcSize=2;strokeColor=#888888;dashed=1;" vertex="1" parent="1"><mxGeometry x="20" y="268" width="230" height="532" as="geometry"/></mxCell><mxCell id="g_cloud" value="AWS Cloud: Step 2, connect data" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontSize=13;arcSize=2;strokeColor=#232F3E;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="605" y="70" width="820" height="730" as="geometry"/></mxCell><mxCell id="g_viz" value="Step 3: visualize and act" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontSize=13;arcSize=2;strokeColor=#34A853;" vertex="1" parent="1"><mxGeometry x="1445" y="70" width="240" height="730" as="geometry"/></mxCell><mxCell id="title" value="&lt;b&gt;Food bank digital twin on AWS Cloud&lt;/b&gt;" style="text;html=1;fontSize=18;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="14" width="900" height="40" as="geometry"/></mxCell><mxCell id="note" value="Solid: in the repository today and deployed in us-east-2 (AWS SAM template; simulated data). Dashed: real-floor path priced in docs/COST_ESTIMATE.md from public list prices; directional, enterprise pricing may differ." style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=top;fontColor=#545B64;" vertex="1" parent="1"><mxGeometry x="20" y="812" width="1640" height="40" as="geometry"/></mxCell><mxCell id="cost" value="&lt;b&gt;Cost controls: pay only while it runs&lt;/b&gt;&lt;br&gt;• API and ingest: Lambda and API Gateway bill per request, so an idle twin costs almost nothing.&lt;br&gt;• Jobs packaged as a container image (WMS import, scene builds): ECS on Fargate, billed per second with a 1-minute minimum, scaled to 0 tasks when idle. Fargate has no GPU.&lt;br&gt;• Omniverse: ECS or AWS Batch on EC2 GPU capacity (on demand or Spot) with a minimum of 0, so an instance exists only while a render runs. New accounts need a GPU quota request.&lt;br&gt;• AWS Budgets alert on the account ($10 for the demo; not in the template)." style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacing=6;arcSize=4;fillColor=#FFF8E1;strokeColor=#E8A33D;" vertex="1" parent="1"><mxGeometry x="1165" y="520" width="250" height="180" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;strokeColor=#545B64;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="video" target="frames"><mxGeometry x="0" relative="1" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;strokeColor=#545B64;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="frames" target="wl"><mxGeometry x="0" relative="1" as="geometry"/></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;strokeColor=#545B64;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="frames" target="train"><mxGeometry x="0" relative="1" as="geometry"/></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;strokeColor=#545B64;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="wl" target="usd"><mxGeometry x="0" relative="1" as="geometry"/></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;strokeColor=#545B64;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="train" target="usd"><mxGeometry x="0" relative="1" as="geometry"/></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;strokeColor=#545B64;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="blender" target="usd"><mxGeometry x="0" relative="1" as="geometry"/></mxCell><mxCell id="e6" value="publish" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;strokeColor=#545B64;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="usd" target="obj"><mxGeometry x="0" relative="1" as="geometry"/></mxCell><mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;strokeColor=#545B64;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="obj" target="cdn"><mxGeometry x="0" relative="1" as="geometry"/></mxCell><mxCell id="e8" value="site, models, USD" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;strokeColor=#545B64;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="cdn" target="browser"><mxGeometry x="0" relative="1" as="geometry"/></mxCell><mxCell id="e9" value="poll every 5 s" style="exitX=0.5;exitY=1;entryX=0.5;entryY=0;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;strokeColor=#545B64;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="browser" target="api"><mxGeometry x="0" relative="1" as="geometry"/></mxCell><mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=