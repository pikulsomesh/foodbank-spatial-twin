<mxfile host="drawio" version="26.2.15"><diagram id="arch" name="azure"><mxGraphModel dx="1700" dy="900" grid="1" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="1720" pageHeight="940" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="g_cap" value="Step 1: video to twin (workstation or CI)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontSize=13;arcSize=2;strokeColor=#E8A33D;" vertex="1" parent="1"><mxGeometry x="20" y="70" width="565" height="180" as="geometry"/></mxCell><mxCell id="g_floor" value="Floor OT (Purdue levels 0 to 2)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontSize=13;arcSize=2;strokeColor=#888888;dashed=1;" vertex="1" parent="1"><mxGeometry x="20" y="268" width="230" height="532" as="geometry"/></mxCell><mxCell id="g_dmz" value="OT DMZ (Purdue level 3.5)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontSize=13;arcSize=2;strokeColor=#C62828;dashed=1;strokeWidth=2;fontColor=#C62828;" vertex="1" parent="1"><mxGeometry x="265" y="268" width="325" height="532" as="geometry"/></mxCell><mxCell id="tb1" value="&lt;b&gt;Trust boundary&lt;/b&gt;&lt;br&gt;every device has its own key or&lt;br&gt;certificate; data leaves the site,&lt;br&gt;nothing comes in except signed,&lt;br&gt;approved firmware" style="text;html=1;fontSize=10;align=center;verticalAlign=top;fontColor=#C62828;" vertex="1" parent="1"><mxGeometry x="300" y="520" width="250" height="80" as="geometry"/></mxCell><mxCell id="g_cloud" value="Microsoft Azure: Step 2, connect data" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontSize=13;arcSize=2;strokeColor=#232F3E;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="605" y="70" width="820" height="730" as="geometry"/></mxCell><mxCell id="g_viz" value="Step 3: visualize and act" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontSize=13;arcSize=2;strokeColor=#34A853;" vertex="1" parent="1"><mxGeometry x="1445" y="70" width="240" height="730" as="geometry"/></mxCell><mxCell id="title" value="&lt;b&gt;Food bank digital twin on Microsoft Azure&lt;/b&gt;" style="text;html=1;fontSize=18;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="14" width="900" height="40" as="geometry"/></mxCell><mxCell id="note" value="Equivalent design, not deployed. Azure IoT Hub has no built-in LoRaWAN network server, so a partner network server forwards uplinks to IoT Hub." style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=top;fontColor=#545B64;" vertex="1" parent="1"><mxGeometry x="20" y="894" width="1640" height="40" as="geometry"/></mxCell><mxCell id="tb2" value="read-only boundary: no write path to the floor" style="endArrow=none;html=1;dashed=1;strokeColor=#C62828;strokeWidth=2;fontSize=10;fontColor=#C62828;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1150" y="262" as="sourcePoint"/><mxPoint x="1150" y="505" as="targetPoint"/></mxGeometry></mxCell><mxCell id="sec" value="&lt;b&gt;OT security: zones, conduits and what is built&lt;/b&gt; (docs/OT_SECURITY.md)&lt;br&gt;Field devices and edge gateways sit on the floor; the OT DMZ passes only outbound TLS; cloud ingest accepts data and sends no commands; the twin is read-only. Existing refrigeration and dock controls are not connected. Red dashed lines are trust boundaries. The only designed path toward the floor is a signed, human-approved firmware update.&lt;br&gt;&lt;b&gt;Built:&lt;/b&gt; nothing on Azure; this is a design only.&lt;br&gt;&lt;b&gt;Design only&lt;/b&gt; (dashed): per-device certificates and keys, least-privilege device policies, segmentation, the edge gateway, device monitoring, plausibility and heartbeat checks on readings, signed updates." style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacing=6;arcSize=4;fillColor=#FDECEA;strokeColor=#C62828;" vertex="1" parent="1"><mxGeometry x="20" y="812" width="1665" height="74" as="geometry"/></mxCell><mxCell id="cost" value="&lt;b&gt;Cost controls: pay only while it runs&lt;/b&gt;&lt;br&gt;• API and ingest: Functions (Consumption) or Container Apps, which scale to zero and bill per second.&lt;br&gt;• Omniverse: a GPU VM on demand or Spot, deallocated after a session. Container Apps serverless GPUs (A100, T4) also scale to zero; not tested with Omniverse.&lt;br&gt;• Cost Management budget alert." style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacing=6;arcSize=4;fillColor=#FFF8E1;strokeColor=#E8A33D;" vertex="1" parent="1"><mxGeometry x="1165" y="520" width="250" height="124" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;strokeColor=#545B64;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="video" target="frames"><mxGeometry x="0" relative="1" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;strokeColor=#545B64;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="frames" target="wl"><mxGeometry x="0" relative="1" as="geometry"/></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;strokeColor=#545B64;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="frames" target="train"><mxGeometry x="0" relative="1" as="geometry"/></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;strokeColor=#545B64;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="wl" target="usd"><mxGeometry x="0" relative="1" as="geomet